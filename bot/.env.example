# Copy to bot/.env on the server. Never commit the real file.

# Discord — from the developer portal (application "FreeInf CTF")
DISCORD_BOT_TOKEN=
# CTFPL server: 374782525647749131. Use the scratch server id while testing.
DISCORD_GUILD_ID=
# Optional: a staff-only text channel where the bot reports unlinked players and what it did
DISCORD_STAFF_CHANNEL_ID=
# Optional: a role whose members should see every squad category (besides Discord admins)
DISCORD_STAFF_ROLE_ID=

# Supabase — the site's project URL and the SERVICE ROLE key (secret)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# How often to do a full reconcile even when nothing changed (minutes)
SYNC_INTERVAL_MINUTES=10
# Set to 1 to log what would change without touching Discord
DRY_RUN=0
