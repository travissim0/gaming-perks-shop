# Zone population history snapshot. Installed but NOT enabled by setup-server.sh:
# enable it only after the old scheduler (pg_cron / cron-job.org / wherever it runs
# today) is turned off, or snapshots double up. Adjust OnCalendar to match the old one.
[Unit]
Description=Snapshot zone population into history

[Timer]
OnCalendar=*:0/15
Persistent=true

[Install]
WantedBy=timers.target
