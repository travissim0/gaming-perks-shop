# Zone population history snapshot. Installed but NOT enabled by setup-server.sh:
# today serverB's crontab runs it every 30 min against https://www.freeinf.org. Enable
# this only after removing that crontab line, or snapshots double up.
[Unit]
Description=Snapshot zone population into history

[Timer]
OnCalendar=*:0/30
Persistent=true

[Install]
WantedBy=timers.target
