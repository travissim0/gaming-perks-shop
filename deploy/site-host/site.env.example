# /etc/freeinf/site.env — runtime env for the site (owner root:web, mode 640).
# Fill from the Vercel dashboard (Project → Settings → Environment Variables → Production),
# or `vercel env pull --environment=production`. NEVER commit the real file.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://www.freeinf.org
SUPABASE_SERVICE_ROLE_KEY=

CRON_SECRET=
ZONE_WEBHOOK_SECRET=
LIVE_INGEST_KEY=
USL_MIX_INGEST_KEY=
KOFI_VERIFICATION_TOKEN=
DONATION_DISPLAY_MODE=

TEXTBELT_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

INFANTRY_DB_HOST=
INFANTRY_DB_PORT=
INFANTRY_DB_NAME=
INFANTRY_DB_USER=
INFANTRY_DB_PASSWORD=
INFANTRY_DB_ENCRYPT=
INFANTRY_RESET_URL=
INFANTRY_RESET_TTL_HOURS=
INFANTRY_SMTP_HOST=
INFANTRY_SMTP_PORT=
INFANTRY_SMTP_USER=
INFANTRY_SMTP_PASSWORD=
INFANTRY_SMTP_FROM=

# Anything else that exists in Vercel but isn't listed here: copy it too.
